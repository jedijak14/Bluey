{
  "name": "bluey-companion",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && cross-env BLUEY_DEV=1 electron .\"",
    "package:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "test": "vitest run",
    "test:ui": "node scripts/ui-smoke.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/*.cjs\"",
    "test:pairing": "node scripts/pairing-smoke.mjs",
    "test:device-speech": "node scripts/device-speech-smoke.mjs",
    "test:features": "node scripts/features-smoke.mjs",
    "test:gemma": "node scripts/gemma-smoke.mjs",
    "test:mobile-site": "node scripts/mobile-site-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-python": "^6.2.1",
    "@uiw/react-codemirror": "^4.25.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "app.bluey.companion",
    "productName": "Bluey",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "*.py",
          "*.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Bluey-${version}-Windows-${arch}-Setup.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "portable": {
      "artifactName": "Bluey-${version}-Windows-${arch}-Portable.${ext}"
    }
  },
  "description": "Bluey \u2014 a local-first Windows and Android desktop companion",
  "author": "Bluey contributors",
  "license": "Unlicense"
}
