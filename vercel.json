{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/gemma/generate.mjs": {
      "maxDuration": 100
    },
    "api/gemma/status.mjs": {
      "maxDuration": 15
    }
  }
}
